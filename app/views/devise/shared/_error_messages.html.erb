<% if resource.errors.any? %>
  <div class="bg-red-950/30 border border-red-800/50 rounded p-4 mb-6">
    <h3 class="text-red-300 font-semibold mb-2">
      <%= pluralize(resource.errors.count, "error") %> prohibited this from being saved:
    </h3>
    <ul class="list-disc list-inside text-sm text-red-400 space-y-1">
      <% resource.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
