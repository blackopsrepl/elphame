<div class="max-w-2xl mx-auto">
  <div class="bg-gray-900 border border-purple-900/30 rounded-lg p-8">
    <h2 class="text-3xl font-bold text-purple-300 mb-6">Edit Your Presence</h2>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "space-y-6", multipart: true }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <!-- Current Avatar Display -->
      <% 
        # Reload from database to get the previously saved avatar, not the new upload
        saved_user = resource.persisted? ? User.find(resource.id) : resource
        if saved_user.avatar.attached?
      %>
        <div class="mb-6">
          <label class="block text-sm font-medium text-gray-400 mb-2">Current Avatar</label>
          <div class="flex items-center space-x-4">
            <%= image_tag saved_user.avatar_thumbnail, class: "w-20 h-20 rounded-full object-cover" %>
            <div class="text-sm text-gray-500">Upload a new image to replace</div>
          </div>
        </div>
      <% end %>

      <div>
        <%= f.label :username, class: "block text-sm font-medium text-gray-400 mb-2" %>
        <%= f.text_field :username, autofocus: true,
            class: "w-full px-4 py-3 bg-gray-950 border border-gray-800 rounded text-gray-200 focus:border-purple-800 focus:outline-none transition",
            placeholder: "Your name in the void" %>
        <p class="mt-1 text-xs text-gray-500">3-20 characters, letters/numbers/underscores/hyphens only. Must be unique.</p>
      </div>

      <div>
        <%= f.label :email, class: "block text-sm font-medium text-gray-400 mb-2" %>
        <%= f.email_field :email, autocomplete: "email",
            class: "w-full px-4 py-3 bg-gray-950 border border-gray-800 rounded text-gray-200 focus:border-purple-800 focus:outline-none transition" %>
        <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
          <p class="mt-1 text-xs text-gray-500">Currently waiting confirmation for: <%= resource.unconfirmed_email %></p>
        <% end %>
      </div>

      <div>
        <%= f.label :avatar, "Avatar (optional)", class: "block text-sm font-medium text-gray-400 mb-2" %>
        <%= f.file_field :avatar, accept: "image/*", 
            class: "w-full px-4 py-3 bg-gray-950 border border-gray-800 rounded text-gray-200 focus:border-purple-800 focus:outline-none transition file:mr-4 file:py-2 file:px-4 file:rounded file:border-0 file:text-sm file:font-semibold file:bg-purple-900 file:text-purple-200 hover:file:bg-purple-800 file:cursor-pointer" %>
        <p class="mt-1 text-xs text-gray-500">Upload a new image to change your avatar</p>
      </div>

      <div class="border-t border-gray-800 pt-6">
        <h3 class="text-xl font-bold text-purple-300 mb-4">Change Password</h3>
        <p class="text-sm text-gray-500 mb-4">Leave blank if you don't want to change it</p>

        <div class="space-y-4">
          <div>
            <%= f.label :password, "New password", class: "block text-sm font-medium text-gray-400 mb-2" %>
            <%= f.password_field :password, autocomplete: "new-password",
                class: "w-full px-4 py-3 bg-gray-950 border border-gray-800 rounded text-gray-200 focus:border-purple-800 focus:outline-none transition" %>
            <% if @minimum_password_length %>
              <p class="mt-1 text-xs text-gray-500"><%= @minimum_password_length %> characters minimum</p>
            <% end %>
          </div>

          <div>
            <%= f.label :password_confirmation, "Confirm new password", class: "block text-sm font-medium text-gray-400 mb-2" %>
            <%= f.password_field :password_confirmation, autocomplete: "new-password",
                class: "w-full px-4 py-3 bg-gray-950 border border-gray-800 rounded text-gray-200 focus:border-purple-800 focus:outline-none transition" %>
          </div>

          <div>
            <%= f.label :current_password, "Current password", class: "block text-sm font-medium text-gray-400 mb-2" %>
            <%= f.password_field :current_password, autocomplete: "current-password",
                class: "w-full px-4 py-3 bg-gray-950 border border-gray-800 rounded text-gray-200 focus:border-purple-800 focus:outline-none transition" %>
            <p class="mt-1 text-xs text-gray-500">We need your current password to confirm your changes</p>
          </div>
        </div>
      </div>

      <div class="flex items-center justify-between pt-4">
        <%= f.submit "Update Profile", class: "px-6 py-3 bg-purple-900 hover:bg-purple-800 border border-purple-800 rounded text-purple-200 font-semibold cursor-pointer transition" %>
        <%= link_to "Back", root_path, class: "text-gray-400 hover:text-purple-300 transition" %>
      </div>
    <% end %>

    <div class="mt-8 pt-8 border-t border-gray-800">
      <h3 class="text-xl font-bold text-red-300 mb-4">Danger Zone</h3>
      <p class="text-sm text-gray-400 mb-4">Permanently delete your account and all associated data. This cannot be undone.</p>
      <%= button_to "Delete My Account", registration_path(resource_name), 
          data: { confirm: "Are you absolutely sure? This will permanently delete your account and all your posts will become anonymous.", turbo_confirm: "Are you absolutely sure? This will permanently delete your account and all your posts will become anonymous." }, 
          method: :delete,
          class: "px-6 py-3 bg-red-900 hover:bg-red-800 border border-red-800 rounded text-red-200 font-semibold cursor-pointer transition" %>
    </div>
  </div>
</div>
