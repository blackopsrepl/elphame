<div class="max-w-md mx-auto">
  <div class="bg-gray-900 border border-purple-900/30 rounded-lg p-8">
    <h2 class="text-3xl font-bold text-purple-300 mb-6">Enter the Veil</h2>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-6" }) do |f| %>
      <div>
        <%= f.label :email, class: "block text-sm font-medium text-gray-400 mb-2" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", 
            class: "w-full px-4 py-3 bg-gray-950 border border-gray-800 rounded text-gray-200 focus:border-purple-800 focus:outline-none transition" %>
      </div>

      <div>
        <%= f.label :password, class: "block text-sm font-medium text-gray-400 mb-2" %>
        <%= f.password_field :password, autocomplete: "current-password", 
            class: "w-full px-4 py-3 bg-gray-950 border border-gray-800 rounded text-gray-200 focus:border-purple-800 focus:outline-none transition" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="flex items-center">
          <%= f.check_box :remember_me, class: "mr-2" %>
          <%= f.label :remember_me, class: "text-sm text-gray-400" %>
        </div>
      <% end %>

      <div>
        <%= f.submit "Sign in", class: "w-full px-6 py-3 bg-purple-900 hover:bg-purple-800 border border-purple-800 rounded text-purple-200 font-semibold cursor-pointer transition" %>
      </div>
    <% end %>

    <div class="mt-6 text-center text-sm">
      <%= link_to "Register", new_registration_path(resource_name), class: "text-purple-400 hover:text-purple-300" %> •
      <%= link_to "Forgot password?", new_password_path(resource_name), class: "text-purple-400 hover:text-purple-300" %>
    </div>

    <div class="mt-6 pt-6 border-t border-gray-800 text-center text-sm text-gray-500">
      Or post without an account (no avatar, soft username only)
    </div>
  </div>
</div>
