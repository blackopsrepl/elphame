<!DOCTYPE html>
<html class="dark">
  <head>
    <title>Elphame Admin</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <style>
      /*
       * Dark theme overrides for Administrate default views.
       * Targets the actual class names from Administrate 1.0 templates:
       *   _index_header, _collection, _collection_item_actions,
       *   show, new, edit, _form, _search, _flashes, _pagination
       */

      /* ── Page headers (index, show, new, edit) ── */
      .administrate-content .main-content__header {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1.5rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid rgba(126, 34, 206, 0.3);
      }
      .administrate-content .main-content__page-title {
        font-size: 1.5rem;
        font-weight: 700;
        color: #c4b5fd;
        margin: 0;
        margin-right: auto;
      }

      /* ── Section body ── */
      .administrate-content .main-content__body {
        margin: 0;
        padding: 0;
      }
      .administrate-content .main-content__body--flush {
        padding-left: 0;
        padding-right: 0;
      }

      /* ── Tables ── */
      .administrate-content table {
        width: 100%;
        border-collapse: collapse;
      }
      .administrate-content table th {
        text-align: left;
        padding: 0.5rem 1rem;
        font-size: 0.75rem;
        font-weight: 600;
        color: #9ca3af;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        border-bottom: 1px solid rgba(126, 34, 206, 0.3);
        background: transparent;
      }
      .administrate-content table th a {
        color: #9ca3af;
      }
      .administrate-content table th a:hover {
        color: #c4b5fd;
      }
      .administrate-content table td {
        padding: 0.75rem 1rem;
        font-size: 0.875rem;
        color: #d1d5db;
        border-bottom: 1px solid #1f2937;
      }
      .administrate-content table tr:hover td {
        background: rgba(31, 41, 55, 0.5);
      }
      .administrate-content .cell-label--action-button {
        white-space: nowrap;
        width: 1px;
        text-align: right;
      }

      /* Sort indicator SVG */
      .administrate-content .cell-label__sort-indicator svg {
        height: 13px;
        width: 13px;
        color: #6b7280;
        display: inline-block;
        vertical-align: middle;
        margin-left: 0.25rem;
      }
      .administrate-content .cell-label__sort-indicator--desc {
        transform: rotate(180deg);
        display: inline-block;
      }

      /* ── Links ── */
      .administrate-content a {
        color: #c4b5fd;
        text-decoration: none;
      }
      .administrate-content a:hover {
        color: #a78bfa;
      }

      /* ── Buttons (.button class — used on show, new, edit, index header) ── */
      .administrate-content .button,
      .administrate-content a.button {
        display: inline-block;
        padding: 0.5rem 1rem;
        border-radius: 0.375rem;
        font-size: 0.875rem;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
        transition: background-color 0.15s;
        background: rgba(126, 34, 206, 0.3);
        border: 1px solid rgba(126, 34, 206, 0.5);
        color: #e9d5ff;
        line-height: 1.5;
      }
      .administrate-content .button:hover,
      .administrate-content a.button:hover {
        background: rgba(126, 34, 206, 0.5);
        color: #e9d5ff;
      }
      .administrate-content .button--danger {
        background: rgba(153, 27, 27, 0.3);
        border: 1px solid rgba(153, 27, 27, 0.5);
        color: #fecaca;
      }
      .administrate-content .button--danger:hover {
        background: rgba(153, 27, 27, 0.5);
        color: #fecaca;
      }

      /* ── Table row action links (action-edit, link, link--danger) ── */
      .administrate-content .action-edit {
        display: inline-block;
        padding: 0.25rem 0.75rem;
        border-radius: 0.25rem;
        font-size: 0.75rem;
        font-weight: 600;
        background: rgba(126, 34, 206, 0.2);
        border: 1px solid rgba(126, 34, 206, 0.4);
        color: #c4b5fd;
        text-decoration: none;
        transition: background-color 0.15s;
      }
      .administrate-content .action-edit:hover {
        background: rgba(126, 34, 206, 0.4);
        color: #e9d5ff;
      }

      /* Destroy button in table rows (button_to wraps in a form) */
      .administrate-content form.button_to {
        display: inline;
        margin: 0;
        padding: 0;
      }
      .administrate-content .link {
        display: inline-block;
        padding: 0.25rem 0.75rem;
        border-radius: 0.25rem;
        font-size: 0.75rem;
        font-weight: 600;
        background: transparent;
        border: 1px solid #374151;
        color: #9ca3af;
        cursor: pointer;
        text-decoration: none;
        transition: all 0.15s;
      }
      .administrate-content .link:hover {
        border-color: #6b7280;
        color: #d1d5db;
      }
      .administrate-content .link--danger {
        border-color: rgba(153, 27, 27, 0.4);
        color: #f87171;
      }
      .administrate-content .link--danger:hover {
        background: rgba(153, 27, 27, 0.2);
        border-color: rgba(153, 27, 27, 0.6);
        color: #fecaca;
      }

      /* ── Show page (dl/dt/dd attributes) ── */
      .administrate-content section dl {
        margin: 0;
      }
      .administrate-content .attribute-label {
        display: block;
        font-size: 0.75rem;
        font-weight: 600;
        color: #9ca3af;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-top: 1.25rem;
        margin-bottom: 0.25rem;
      }
      .administrate-content .attribute-label:first-child {
        margin-top: 0;
      }
      .administrate-content .attribute-data {
        font-size: 0.875rem;
        color: #e5e7eb;
        margin: 0;
        padding: 0.5rem 0.75rem;
        background: rgba(3, 7, 18, 0.3);
        border: 1px solid #1f2937;
        border-radius: 0.375rem;
      }
      .administrate-content fieldset {
        border: none;
        margin: 0;
        padding: 0;
      }
      .administrate-content legend {
        font-size: 1rem;
        font-weight: 600;
        color: #c4b5fd;
        margin-bottom: 0.5rem;
        margin-top: 1.5rem;
      }

      /* ── Search form ── */
      .administrate-content .search {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin: 0;
      }
      .administrate-content .search__label {
        display: flex;
        align-items: center;
      }
      .administrate-content .search__eyeglass-icon {
        width: 1rem;
        height: 1rem;
        color: #6b7280;
      }
      .administrate-content .search__input {
        padding: 0.5rem 0.75rem;
        background: #030712;
        border: 1px solid #374151;
        border-radius: 0.375rem;
        color: #e5e7eb;
        font-size: 0.875rem;
        min-width: 200px;
      }
      .administrate-content .search__input:focus {
        outline: none;
        border-color: #7e22ce;
      }
      .administrate-content .search__clear-link {
        display: flex;
        align-items: center;
      }
      .administrate-content .search__clear-icon {
        width: 1rem;
        height: 1rem;
        color: #6b7280;
      }
      .administrate-content .search__clear-icon:hover {
        color: #f87171;
      }

      /* ── Forms ── */
      .administrate-content .form {
        max-width: 40rem;
      }
      .administrate-content .field-unit {
        margin-bottom: 1.5rem;
      }
      .administrate-content .field-unit__label,
      .administrate-content .field-unit label {
        display: block;
        font-size: 0.875rem;
        font-weight: 500;
        color: #9ca3af;
        margin-bottom: 0.5rem;
      }
      .administrate-content .field-unit input[type="text"],
      .administrate-content .field-unit input[type="email"],
      .administrate-content .field-unit input[type="password"],
      .administrate-content .field-unit input[type="number"],
      .administrate-content .field-unit input[type="url"],
      .administrate-content .field-unit input[type="search"],
      .administrate-content .field-unit textarea,
      .administrate-content .field-unit select {
        width: 100%;
        padding: 0.75rem 1rem;
        background: #030712;
        border: 1px solid #374151;
        border-radius: 0.375rem;
        color: #e5e7eb;
        font-size: 0.875rem;
      }
      .administrate-content .field-unit input:focus,
      .administrate-content .field-unit textarea:focus,
      .administrate-content .field-unit select:focus {
        outline: none;
        border-color: #7e22ce;
      }
      .administrate-content .field-unit input[type="checkbox"] {
        width: auto;
      }
      .administrate-content .form-actions {
        margin-top: 2rem;
        padding-top: 1.5rem;
        border-top: 1px solid #1f2937;
      }

      /* Submit buttons */
      .administrate-content button[type="submit"],
      .administrate-content input[type="submit"] {
        padding: 0.75rem 1.5rem;
        background: rgba(126, 34, 206, 0.5);
        border: 1px solid #7e22ce;
        border-radius: 0.375rem;
        color: #e9d5ff;
        font-weight: 600;
        cursor: pointer;
        font-size: 0.875rem;
      }
      .administrate-content button[type="submit"]:hover,
      .administrate-content input[type="submit"]:hover {
        background: rgba(126, 34, 206, 0.7);
      }

      /* Form error state */
      .administrate-content #error_explanation {
        margin-bottom: 1.5rem;
        padding: 1rem;
        background: rgba(153, 27, 27, 0.15);
        border: 1px solid rgba(153, 27, 27, 0.4);
        border-radius: 0.375rem;
      }
      .administrate-content #error_explanation h2 {
        font-size: 0.875rem;
        font-weight: 600;
        color: #fecaca;
        margin: 0 0 0.5rem;
      }
      .administrate-content #error_explanation ul {
        margin: 0;
        padding-left: 1.25rem;
      }
      .administrate-content #error_explanation li,
      .administrate-content .flash-error {
        color: #f87171;
        font-size: 0.8125rem;
      }

      /* ── Flash messages (Administrate uses flash-<key>, not flash--<key>) ── */
      .administrate-content .flashes {
        margin-bottom: 1rem;
      }
      .administrate-content .flash {
        padding: 1rem;
        border-radius: 0.375rem;
        margin-bottom: 0.5rem;
      }
      .administrate-content .flash-notice {
        background: rgba(126, 34, 206, 0.2);
        border: 1px solid rgba(126, 34, 206, 0.4);
        color: #c4b5fd;
      }
      .administrate-content .flash-alert,
      .administrate-content .flash-error {
        background: rgba(153, 27, 27, 0.2);
        border: 1px solid rgba(153, 27, 27, 0.4);
        color: #fecaca;
      }

      /* ── Pagination ── */
      .administrate-content .pagination {
        display: flex;
        gap: 0.25rem;
        margin-top: 1.5rem;
        padding: 0 1rem;
      }
      .administrate-content .pagination a,
      .administrate-content .pagination span {
        padding: 0.5rem 0.75rem;
        border-radius: 0.25rem;
        font-size: 0.875rem;
      }
      .administrate-content .pagination a {
        background: #1f1f2e;
        color: #c4b5fd;
        border: 1px solid rgba(126, 34, 206, 0.3);
      }
      .administrate-content .pagination .current {
        background: rgba(126, 34, 206, 0.5);
        color: #e9d5ff;
        border: 1px solid #7e22ce;
      }

      /* ── Has-many nested tables on show pages ── */
      .administrate-content .has-many-fields {
        margin-top: 0.5rem;
      }

      /* ── Administrate navigation (hidden — we use our own sidebar) ── */
      .administrate-content .navigation {
        display: none;
      }
    </style>
  </head>

  <body class="bg-gray-950 text-gray-200 min-h-screen">
    <div class="flex min-h-screen">
      <!-- Sidebar -->
      <aside class="w-64 bg-gray-900 border-r border-purple-900/30 flex flex-col">
        <div class="p-6 border-b border-purple-900/30">
          <%= link_to admin_root_path, class: "flex items-center space-x-2 text-purple-400 hover:text-purple-300 transition" do %>
            <span class="text-2xl">🌙</span>
            <span class="text-xl font-bold">Elphame Admin</span>
          <% end %>
        </div>

        <nav class="flex-1 p-4 space-y-1">
          <%= link_to admin_root_path, class: "flex items-center gap-3 px-4 py-2.5 rounded-lg text-sm font-medium #{request.path == admin_root_path ? 'bg-purple-900/50 text-purple-200 border border-purple-800/50' : 'text-gray-400 hover:text-purple-300 hover:bg-gray-800/50'} transition" do %>
            <span>📊</span><span>Dashboard</span>
          <% end %>

          <div class="pt-4 pb-2">
            <span class="px-4 text-xs font-semibold text-gray-600 uppercase tracking-wider">Content</span>
          </div>

          <%= link_to admin_realms_path, class: "flex items-center gap-3 px-4 py-2.5 rounded-lg text-sm font-medium #{controller_name == 'realms' ? 'bg-purple-900/50 text-purple-200 border border-purple-800/50' : 'text-gray-400 hover:text-purple-300 hover:bg-gray-800/50'} transition" do %>
            <span>🌐</span><span>Realms</span>
          <% end %>

          <%= link_to admin_discussions_path, class: "flex items-center gap-3 px-4 py-2.5 rounded-lg text-sm font-medium #{controller_name == 'discussions' ? 'bg-purple-900/50 text-purple-200 border border-purple-800/50' : 'text-gray-400 hover:text-purple-300 hover:bg-gray-800/50'} transition" do %>
            <span>💬</span><span>Discussions</span>
          <% end %>

          <%= link_to admin_posts_path, class: "flex items-center gap-3 px-4 py-2.5 rounded-lg text-sm font-medium #{controller_name == 'posts' ? 'bg-purple-900/50 text-purple-200 border border-purple-800/50' : 'text-gray-400 hover:text-purple-300 hover:bg-gray-800/50'} transition" do %>
            <span>📝</span><span>Posts</span>
          <% end %>

          <div class="pt-4 pb-2">
            <span class="px-4 text-xs font-semibold text-gray-600 uppercase tracking-wider">Users & Ratings</span>
          </div>

          <%= link_to admin_users_path, class: "flex items-center gap-3 px-4 py-2.5 rounded-lg text-sm font-medium #{controller_name == 'users' ? 'bg-purple-900/50 text-purple-200 border border-purple-800/50' : 'text-gray-400 hover:text-purple-300 hover:bg-gray-800/50'} transition" do %>
            <span>👥</span><span>Users</span>
          <% end %>

          <%= link_to admin_star_ratings_path, class: "flex items-center gap-3 px-4 py-2.5 rounded-lg text-sm font-medium #{controller_name == 'star_ratings' ? 'bg-purple-900/50 text-purple-200 border border-purple-800/50' : 'text-gray-400 hover:text-purple-300 hover:bg-gray-800/50'} transition" do %>
            <span>⭐</span><span>Star Ratings</span>
          <% end %>

          <div class="pt-4 pb-2">
            <span class="px-4 text-xs font-semibold text-gray-600 uppercase tracking-wider">Organization</span>
          </div>

          <%= link_to admin_labels_path, class: "flex items-center gap-3 px-4 py-2.5 rounded-lg text-sm font-medium #{controller_name == 'labels' ? 'bg-purple-900/50 text-purple-200 border border-purple-800/50' : 'text-gray-400 hover:text-purple-300 hover:bg-gray-800/50'} transition" do %>
            <span>🏷️</span><span>Labels</span>
          <% end %>

          <%= link_to admin_thread_labels_path, class: "flex items-center gap-3 px-4 py-2.5 rounded-lg text-sm font-medium #{controller_name == 'thread_labels' ? 'bg-purple-900/50 text-purple-200 border border-purple-800/50' : 'text-gray-400 hover:text-purple-300 hover:bg-gray-800/50'} transition" do %>
            <span>🔗</span><span>Thread Labels</span>
          <% end %>

          <div class="pt-4 pb-2">
            <span class="px-4 text-xs font-semibold text-gray-600 uppercase tracking-wider">System</span>
          </div>

          <%= link_to admin_admin_actions_path, class: "flex items-center gap-3 px-4 py-2.5 rounded-lg text-sm font-medium #{controller_name == 'admin_actions' ? 'bg-purple-900/50 text-purple-200 border border-purple-800/50' : 'text-gray-400 hover:text-purple-300 hover:bg-gray-800/50'} transition" do %>
            <span>📋</span><span>Audit Log</span>
          <% end %>
        </nav>

        <div class="p-4 border-t border-purple-900/30 space-y-1">
          <div class="flex items-center gap-3 px-4 py-2 text-sm text-gray-500">
            <span>👤</span>
            <span><%= current_user&.username %></span>
          </div>
          <%= link_to root_path, class: "flex items-center gap-3 px-4 py-2 text-sm text-gray-500 hover:text-purple-300 transition" do %>
            <span>🌙</span><span>View Imageboard</span>
          <% end %>
          <%= button_to destroy_user_session_path, method: :delete, class: "flex items-center gap-3 px-4 py-2 text-sm text-gray-500 hover:text-red-400 transition w-full text-left cursor-pointer" do %>
            <span>🚪</span><span>Sign Out</span>
          <% end %>
        </div>
      </aside>

      <!-- Main Content -->
      <main class="flex-1 overflow-auto">
        <div class="p-8">
          <% if notice.present? %>
            <div class="mb-4 p-4 rounded border border-purple-800/50 bg-purple-950/30 text-purple-300">
              <%= notice %>
            </div>
          <% end %>

          <% if alert.present? %>
            <div class="mb-4 p-4 rounded border border-red-800/50 bg-red-950/30 text-red-300">
              <%= alert %>
            </div>
          <% end %>

          <div class="administrate-content">
            <%= yield %>
          </div>
        </div>
      </main>
    </div>
  </body>
</html>
