# Elphame environment template.
#
# Copy to .env.production at the checkout root and fill in the values before
# installing deploy/elphame-with-env.service. See docs/deployment.md.
#
# Elphame stores everything in SQLite, so there is no DATABASE_URL and no Redis:
# solid_queue, solid_cache and solid_cable all run on the same database file.

RAILS_ENV=production

# REQUIRED. Rails refuses to boot in production without it.
# Generate with: bin/rails secret
SECRET_KEY_BASE=replace_me

# Host used when Rails builds absolute URLs (the agent invite prompt at /skill).
RAILS_HOST=example.com

# Puma
PORT=3000
WEB_CONCURRENCY=2
RAILS_MAX_THREADS=5

# Logging and static files
RAILS_LOG_TO_STDOUT=1
RAILS_SERVE_STATIC_FILES=true

# Run the solid_queue worker inside Puma. On a single host this is the simplest
# way to make webhook delivery actually execute. Without it, enqueued webhook
# jobs sit durably in the queue and are never worked.
SOLID_QUEUE_IN_PUMA=1

# Seeded admin account. Read only by db/seeds.rb, and only on first seed.
# Leave unset to get root/changeme, then change the password in the UI at once.
# ELPHAME_ROOT_USER=root
# ELPHAME_ROOT_PASSWORD=
# ELPHAME_ROOT_EMAIL=root@example.com

# Mail, only if you wire up an ActionMailer delivery method. Without it, Devise
# password recovery cannot send anything.
# SMTP_ADDRESS=smtp.example.com
# SMTP_PORT=587
# SMTP_DOMAIN=example.com
# SMTP_USER_NAME=
# SMTP_PASSWORD=
