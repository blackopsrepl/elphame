# Rails Configuration
RAILS_ENV=production
RAILS_MAX_THREADS=5
WEB_CONCURRENCY=2
PORT=3000
RAILS_LOG_TO_STDOUT=1
RAILS_SERVE_STATIC_FILES=true

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost/elphame_production

# Secret Key Base (generate with: rails secret)
SECRET_KEY_BASE=your_secret_key_base_here

# Redis URL (if using Redis for caching/Action Cable)
# REDIS_URL=redis://localhost:6379/0

# Solid Queue/Cache/Cable (if using)
# SOLID_QUEUE_IN_PUMA=1

# Application Host
RAILS_HOST=example.com

# Asset Host (CDN)
# ASSET_HOST=https://cdn.example.com

# Mail Configuration
# SMTP_ADDRESS=smtp.example.com
# SMTP_PORT=587
# SMTP_DOMAIN=example.com
# SMTP_USER_NAME=your_email@example.com
# SMTP_PASSWORD=your_password
# SMTP_AUTHENTICATION=plain
# SMTP_ENABLE_STARTTLS_AUTO=true

# Additional Configuration
# Add any other environment variables your application needs