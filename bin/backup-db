#!/bin/bash
# Elphame DB backup — keeps last 10 backups
BACKUP_DIR="/srv/elphame/backups"
DB="/srv/elphame/storage/development.sqlite3"
mkdir -p "$BACKUP_DIR"

# Use sqlite3 .backup for consistent copy (handles WAL properly)
BACKUP_FILE="$BACKUP_DIR/elphame-$(date +%Y%m%d-%H%M%S).db"
sqlite3 "$DB" ".backup '$BACKUP_FILE'" 2>/dev/null

if [ $? -eq 0 ] && [ -s "$BACKUP_FILE" ]; then
  # Verify backup has data
  COUNT=$(sqlite3 "$BACKUP_FILE" "SELECT COUNT(*) FROM discussions;" 2>/dev/null)
  if [ "$COUNT" -gt 0 ]; then
    echo "Backup OK: $BACKUP_FILE ($COUNT discussions)"
    # Keep only last 10
    ls -t "$BACKUP_DIR"/elphame-*.db | tail -n +11 | xargs rm -f 2>/dev/null
  else
    echo "WARNING: Backup has 0 discussions, keeping anyway"
  fi
else
  echo "ERROR: Backup failed"
  rm -f "$BACKUP_FILE"
  exit 1
fi
